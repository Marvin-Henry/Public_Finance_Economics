return(x %>%
rename("PCE" = pce, "Firm Capital" = firm_capital, "Fed Rate" = DFF,
"US Firm Profit" = Domestic.industries, "Govt Ex" = govt_spending,
"Taxes" = current_taxes, "US Debt" = public_debt, "DGSTEN" = DGS10))
}
